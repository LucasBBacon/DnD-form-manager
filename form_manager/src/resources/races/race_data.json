                                    "target": "strength",
                                    "value": 2
                                }
                            ]
                        }
                    },
                    {
                        "id": "dwarven_armor_training"
                    }
                ]
            },
            "hill_dwarf": {
                "label": "Hill Dwarf",
                "traits": [
                    {
                        "id": "ability_score_increase",
