    "half_elf": {
        "label": "Half Elf",
        "traits": [
            {
                "id": "ability_score_increase",
                "overrides": {
                    "description": "Your Charisma score increases by 1, and two other ability scores of your choice increases by 1.",
                    "modifiers": [
                        {
                            "type": "ability_bonus",
                            "target": "charisma",
                            "value": 2
                        },
                        {
                            "type": "ability_bonus_choice",
                            "count": 2,
                            "pool": "any"
                        }
                    ]
                }
            },
            {
                "id": "age",
                "overrides": {
                    "description": "Half-elves mature at the same rate humans do and reach adulthood around the age of 20. They live much longer than humans, however, often exceeding 180 years."
                }
            },
            {
                "id": "alignment",
                "overrides": {
                    "description": "Half-elves share the chaotic bent of their elven heritage. They value both personal freedom and creative expression, demonstrating neither love of leaders nor desire for followers. They chafe at rules, resent others' demands, and sometimes prove unreliable, or at least unpredictable."
                }
            },
            {
                "id": "size",
                "overrides": {
                    "description": "Half-elves are about the same size as humans, ranging from 5 to 6 feet tall. Your size is Medium."
                }
            },
            {
                "id": "speed"
            },
            {
                "id": "darkvision",
                "overrides": {
                    "description": "Thanks to your elfblood, you have superior vision in dark and dim conditions. You can see in dim light within 60 feet of you as if it were bright light, and in darkness as if it were dim light. You can't discern color in darkness, only shades of gray."
                }
            },
            {
                "id": "fey_ancestry"
            },
            {
                "id": "skill_versatility"
            },
            {
                "id": "languages",
                "overrides": {
                    "description": "You can speak, read, and write Common, Elvish, and one extra language of your choice.",
                    "modifiers": [
                        {
                            "type": "language_grant",
                            "language": "common"
                        },
                        {
                            "type": "language_grant",
                            "language": "elvish"
                        },
                        {
                            "type": "language_choice",
                            "count": 1,
                            "pool": "any"
                        }
                    ]
                }
            }
        ]
    },
