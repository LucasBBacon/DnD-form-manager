{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "title": "DnD Spell",
    "description": "A dictionary of D&D 5e spells optimized for programmatic game engine.",
    "type": "object",
    "patternProperties": {
        "^spell_[a-z0-9_]+$": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "level": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9
                },
                "school": {
                    "type": "string"
                },
                "is_ritual": {
                    "type": "boolean"
                },
                "classes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "casting_time": {
                    "type": "object",
                    "properties": {
                        "action_type": {
                            "type": "string",
                            "enum": [
                                "action",
                                "bonus_action",
                                "reaction",
                                "minute",
                                "hour"
                            ]
                        },
                        "value": {
                            "type": "integer"
                        },
                        "condition": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "action_type",
                        "value"
                    ]
                },
                "range": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "enum": [
                                "self",
                                "touch",
                                "ranged",
                                "unlimited"
                            ]
                        },
                        "distance": {
                            "type": "integer"
                        },
                        "unit": {
                            "type": "string",
                            "enum": [
                                "feet",
                                "miles",
                                null
                            ]
                        }
                    },
                    "required": [
                        "type"
                    ]
                },
                "components": {
                    "type": "object",
                    "properties": {
                        "v": {
                            "type": "boolean"
                        },
                        "s": {
                            "type": "boolean"
                        },
                        "m": {
                            "type": "boolean"
                        },
                        "materials": {
                            "type": "string"
                        },
                        "consumed": {
                            "type": "boolean"
                        }
                    }
                },
                "duration": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "enum": [
                                "instantaneous",
                                "timed",
                                "permanent",
                                "special"
                            ]
                        },
                        "value": {
                            "type": "integer"
                        },
                        "unit": {
                            "type": "string",
                            "enum": [
                                "round",
                                "minute",
                                "hour",
                                "day"
                            ]
                        },
                        "concentration": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "type",
                        "concentration"
                    ]
                },
                "mechanics": {
                    "type": "object",
                    "properties": {
                        "casting_options": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "option_name": {
                                        "type": "string"
                                    },
                                    "choices": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "required": [
                                    "option_name",
                                    "choices"
                                ]
                            }
                        },
                        "targeting": {
                            "type": "object",
                            "properties": {
                                "target_type": {
                                    "type": "string",
                                    "enum": [
                                        "self",
                                        "creature",
                                        "object",
                                        "point",
                                        "area"
                                    ]
                                },
                                "min_targets": {
                                    "type": "integer"
                                },
                                "max_targets": {
                                    "type": "integer"
                                },
                                "distribution": {
                                    "type": "object",
                                    "properties": {
                                        "pool_size": {
                                            "type": "integer",
                                            "description": "the number of projectiles/attacks to distribute."
                                        },
                                        "allow_multiple_hits_per_target": {
                                            "type": "boolean"
                                        }
                                    },
                                    "required": [
                                        "pool_size",
                                        "allow_multiple_hits_per_target"
                                    ]
                                },
                                "aoe_shape": {
                                    "type": "string",
                                    "enum": [
                                        "sphere",
                                        "cone",
                                        "cylinder",
                                        "line",
                                        "cube",
                                        null
                                    ]
                                },
                                "aoe_size": {
                                    "type": "integer"
                                },
                                "restrictions": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "condition": {
                                                "type": "string"
                                            },
                                            "value": {
                                                "type": [
                                                    "string",
                                                    "integer",
                                                    "boolean"
                                                ]
                                            },
                                            "unit": {
                                                "type": "string"
                                            }
                                        },
                                        "required": [
                                            "condition",
                                            "value"
                                        ]
                                    }
                                }
                            },
                            "required": [
                                "target_type"
                            ]
                        },
                        "resolution": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "enum": [
                                        "attack_roll",
                                        "saving_throw",
                                        "automatic"
                                    ]
                                },
                                "attack_type": {
                                    "type": "string",
                                    "enum": [
                                        "melee",
                                        "ranged"
                                    ]
                                },
                                "save_ability": {
                                    "type": "string",
                                    "enum": [
                                        "str",
                                        "dex",
                                        "con",
                                        "int",
                                        "wis",
                                        "cha"
                                    ]
                                },
                                "save_success": {
                                    "type": "string",
                                    "enum": [
                                        "half_damage",
                                        "no_effect"
                                    ]
                                }
                            },
                            "required": [
                                "type"
                            ]
                        },
                        "effects": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "required_choice": {
                                        "type": "string"
                                    },
                                    "effect_type": {
                                        "type": "string",
                                        "enum": [
                                            "damage",
                                            "healing",
                                            "condition",
                                            "utility",
                                            "attribute_modification",
                                            "grant_action"
                                        ]
                                    },
                                    "roll": {
                                        "type": "string",
                                        "description": "e.g., '8d6'"
                                    },
                                    "damage_type": {
                                        "type": "string"
                                    },
                                    "condition_applied": {
                                        "type": "string"
                                    },
                                    "attributes_affected": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    "modifier_value": {
                                        "type": [
                                            "integer",
                                            "string"
                                        ]
                                    },
                                    "utility_action": {
                                        "type": "string",
                                        "enum": [
                                            "alert",
                                            "summon",
                                            "teleport",
                                            "create_item",
                                            "dispel",
                                            "open_ui"
                                        ]
                                    },
                                    "granted_action": {
                                        "type": "object",
                                        "properties": {
                                            "name": {
                                                "type": "string"
                                            },
                                            "action_type": {
                                                "type": "string",
                                                "enum": [
                                                    "action",
                                                    "bonus_action",
                                                    "reaction"
                                                ]
                                            },
                                            "effects": {
                                                "type": "array",
                                                "description": "The effects that occur when this temporary action is used.",
                                                "items": {
                                                    "$ref": "#/patternProperties/^spell_[a-z0-9_]+$/properties/mechanics/properties/effects/items"
                                                }
                                            }
                                        },
                                        "required": [
                                            "name",
                                            "action_type",
                                            "effects"
                                        ]
                                    },
                                    "scaling": {
                                        "type": "object",
                                        "properties": {
                                            "scaling_type": {
                                                "type": "string",
                                                "enum": [
                                                    "slot_level",
                                                    "character_level"
                                                ]
                                            },
                                            "increment_roll": {
                                                "type": "string"
                                            },
                                            "increment_targets": {
                                                "type": "integer"
                                            },
                                            "increment_modifier": {
                                                "type": "integer"
                                            },
                                            "increment_duration_value": {
                                                "type": "integer"
                                            },
                                            "increment_pool_size": {
                                                "type": "integer"
                                            },
                                            "breakpoints": {
                                                "type": "array",
                                                "items": {
                                                    "type": "object",
                                                    "properties": {
                                                        "level": {
                                                            "type": "integer"
                                                        },
                                                        "roll": {
                                                            "type": "string"
                                                        },
                                                        "modifier": {
                                                            "type": "integer"
                                                        }
                                                    },
                                                    "required": [
                                                        "level"
                                                    ]
                                                }
                                            }
                                        },
                                        "required": [
                                            "scaling_type"
                                        ]
                                    },
                                    "trigger": {
                                        "type": "object",
                                        "properties": {
                                            "event": {
                                                "type": "string",
                                                "enum": [
                                                    "enters_area",
                                                    "starts_turn_in_area",
                                                    "end_turn_in_area",
                                                    "touches_target",
                                                    "takes_damage"
                                                ]
                                            },
                                            "filters": {
                                                "type": "array",
                                                "items": {
                                                    "type": "object",
                                                    "properties": {
                                                        "attribute": {
                                                            "type": "string"
                                                        },
                                                        "operator": {
                                                            "type": "string",
                                                            "enum": [
                                                                "==",
                                                                "!=",
                                                                ">=",
                                                                "<=",
                                                                "includes",
                                                                "excludes"
                                                            ]
                                                        },
                                                        "value": {
                                                            "type": [
                                                                "string",
                                                                "integer",
                                                                "boolean"
                                                            ]
                                                        }
                                                    },
                                                    "required": [
                                                        "attribute",
                                                        "operator",
                                                        "value"
                                                    ]
                                                }
                                            }
                                        },
                                        "required": [
                                            "event"
                                        ]
                                    }
                                },
                                "required": [
                                    "effect_type"
                                ]
                            }
                        }
                    },
                    "required": [
                        "targeting",
                        "resolution",
                        "effects"
                    ]
                },
                "description": {
                    "type": "string"
                }
            },
            "required": [
                "name",
                "level",
                "is_ritual",
                "classes",
                "casting_time",
                "range",
                "components",
                "duration",
                "mechanics",
                "description"
            ]
        }
    }
}