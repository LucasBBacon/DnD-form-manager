{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "title": "DnD Trait",
    "type": "object",
    "patternProperties": {
        "^trait_[a-z0-9_]+$": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Display name of the trait."
                },
                "is_active": {
                    "type": "boolean",
                    "default": false,
                    "description": "True if the trait grants an action/bonus action (e.g., Dragon Breath), False if purely passive."
                },
                "activation_type": {
                    "type": "string",
                    "enum": [
                        "action",
                        "bonus_action",
                        "reaction",
                        "special"
                    ],
                    "description": "Required if is_active is true. Defines the action economy."
                },
                "uses": {
                    "type": "object",
                    "description": "Defines how many times an active trait can be used and when it resets.",
                    "properties": {
                        "count": {
                            "type": [
                                "integer",
                                "string"
                            ],
                            "description": "Number of uses (can be a string if tied to a scaling  stat like 'proficiency_bonus')."
                        },
                        "reset": {
                            "type": "string",
                            "enum": [
                                "short_rest",
                                "long_rest",
                                "turn",
                                "initiative",
                                "other"
                            ]
                        }
                    }
                },
                "effects": {
                    "type": "array",
                    "description": "The discrete mechanical changes applied to the character sheet.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "enum": [
                                    "sense",
                                    "proficiency",
                                    "resistance",
                                    "immunity",
                                    "advantage",
                                    "spell_grant",
                                    "stat_modifier",
                                    "speed",
                                    "ac_calc",
                                    "rule_bypass"
                                ]
                            },
                            "level_available": {
                                "type": "integer",
                                "default": 1,
                                "description": "Character level required for this specific effect to trigger (e.g., Drow Magic scaling)."
                            },
                            "target": {
                                "type": "string",
                                "description": "What is being modified (e.g., 'darkvision', 'poison', 'hp_max')"
                            },
                            "value": {
                                "type": [
                                    "integer",
                                    "string",
                                    "boolean"
                                ],
                                "description": "The magnitude of the effect."
                            },
                            "condition": {
                                "type": "string",
                                "description": "Context required for the effect (e.g., 'against_poison', 'in_direct_sunlight')"
                            },
                            "spellcasting_ability": {
                                "type": "string",
                                "enum": [
                                    "str",
                                    "dex",
                                    "con",
                                    "int",
                                    "wis",
                                    "cha"
                                ],
                                "description": "The ability score used for DCs/Attack Rolls when type is 'spell_grant'."
                            },
                            "choice": {
                                "type": "object",
                                "description": "Used when the trait requires the player to make a selection.",
                                "properties": {
                                    "count": {
                                        "type": "integer"
                                    },
                                    "category": {
                                        "type": "string",
                                        "enum": [
                                            "skill",
                                            "tool",
                                            "weapon",
                                            "spell",
                                            "language",
                                            "armor"
                                        ]
                                    },
                                    "pool": {
                                        "type": "string",
                                        "description": "Identifier for the list of valid options (e.g., 'any_skill', 'wizard_cantrips', 'artisan_tools'"
                                    }
                                }
                            }
                        },
                        "required": [
                            "type"
                        ],
                        "allOf": [
                            {
                                "if": {
                                    "properties": {
                                        "type": {
                                            "const": "proficiency"
                                        }
                                    }
                                },
                                "then": {
                                    "required": [
                                        "target"
                                    ]
                                }
                            },
                            {
                                "if": {
                                    "properties": {
                                        "type": {
                                            "const": "resistance"
                                        }
                                    }
                                },
                                "then": {
                                    "required": [
                                        "target"
                                    ]
                                }
                            },
                            {
                                "if": {
                                    "properties": {
                                        "type": {
                                            "const": "immunity"
                                        }
                                    }
                                },
                                "then": {
                                    "required": [
                                        "target"
                                    ]
                                }
                            },
                            {
                                "if": {
                                    "properties": {
                                        "type": {
                                            "const": "stat_modifier"
                                        }
                                    }
                                },
                                "then": {
                                    "required": [
                                        "target",
                                        "value"
                                    ]
                                }
                            }
                        ]
                    }
                },
                "lore": {
                    "type": "object",
                    "properties": {
                        "short_description": {
                            "type": "string",
                            "description": "A quick 1-2 sentence summary for tooltips."
                        },
                        "full_text": {
                            "type": "string",
                            "description": "The main body of text for the entity."
                        },
                        "sections": {
                            "type": "array",
                            "description": "Flexible key-value pairs for categorized flavor text (Age, Alignment, Lore, etc.).",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "title": {
                                        "type": "string"
                                    },
                                    "body": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "title",
                                    "body"
                                ]
                            }
                        }
                    },
                    "required": [
                        "short_description"
                    ]
                }
            },
            "required": [
                "name",
                "effects"
            ]
        }
    }
}