{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "title": "DnD Subclass",
    "description": "",
    "type": "object",
    "patternProperties": {
        "^subclass_[a-z0-9_]+$": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "parent_class_id": {
                    "type": "string",
                    "description": "The Id of the base class this belongs to (e.g., 'class_rogue')"
                },
                "spellcasting_override": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "description": "Used if the subclass introduces spellcasting to a martial class, or changes the base class casting rules.",
                    "properties": {
                        "ability": {
                            "type": "string",
                            "enum": [
                                "int",
                                "wis",
                                "cha"
                            ]
                        },
                        "preparation_type": {
                            "type": "string",
                            "enum": [
                                "known",
                                "prepared",
                                "pact"
                            ]
                        }
                    }
                },
                "progression": {
                    "type": "object",
                    "description": "Only contains objects for the specific levels where this subclass grants features.",
                    "patternProperties": {
                        "^(1[0-9]|20|[1-9])$": {
                            "type": "object",
                            "properties": {
                                "features": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "description": "Trait IDs granted at this specific level."
                                },
                                "subclass_specific_scaling": {
                                    "type": [
                                        "object",
                                        "null"
                                    ],
                                    "description": "Custom key-value pairs for class-specific resources (e.g., Sneak Attack damage, Ki points).",
                                    "additionalProperties": {
                                        "type": [
                                            "string",
                                            "integer"
                                        ]
                                    }
                                },
                                "bonus_spells": {
                                    "type": [
                                        "array",
                                        "null"
                                    ],
                                    "items": {
                                        "type": "string"
                                    },
                                    "description": "Spell IDs automatically learned/prepared at this level (e.g., Cleric Domain spells, Warlock Patron spells)."
                                },
                                "spells_added_to_list": {
                                    "type": [
                                        "array",
                                        "null"
                                    ],
                                    "items": {
                                        "type": "string"
                                    },
                                    "description": "Spell IDs added to the class's valid spell list to choose from. rather than automatically learned."
                                },
                                "spellcasting_progression_additions": {
                                    "type": [
                                        "object",
                                        "null"
                                    ],
                                    "description": "Used for 'third-casters' (Like Eldritch Knight) to add spell slots, or Warlocks to expand their specific slot logic.",
                                    "properties": {
                                        "cantrips_known": {
                                            "type": "integer"
                                        },
                                        "spells_known": {
                                            "type": "integer"
                                        },
                                        "spell_slots": {
                                            "type": "object",
                                            "additionalProperties": {
                                                "type": "integer"
                                            }
                                        }
                                    }
                                }
                            },
                            "required": [
                                "features"
                            ]
                        }
                    }
                }
            },
            "required": [
                "name",
                "parent_class_id",
                "progression"
            ]
        }
    }
}