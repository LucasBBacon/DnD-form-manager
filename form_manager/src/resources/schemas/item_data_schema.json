{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "title": "DnD Item",
    "type": "object",
    "patternProperties": {
        "^item_[a-z0-9_]+$": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Display name of the item."
                },
                "category": {
                    "type": "string",
                    "enum": [
                        "weapon",
                        "armor",
                        "gear",
                        "tool",
                        "magic_item",
                        "ammunition"
                    ],
                    "description": "The primary categorization for UI filtering."
                },
                "weight": {
                    "type": "number",
                    "description": "Weight in pounds."
                },
                "cost": {
                    "type": "number",
                    "description": "Cost of item in copper pieces."
                },
                "rarity": {
                    "type": "string",
                    "enum": [
                        "common",
                        "uncommon",
                        "rare",
                        "very_rare",
                        "legendary",
                        "artifact"
                    ],
                    "default": "common",
                    "description": "The rarity of the item, used for loot generation and sorting."
                },
                "requires_attunement": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether the item requires attunement to function."
                },
                "weapon_data": {
                    "type": "object",
                    "description": "If present, the engine treats this item as wieldable in combat.",
                    "properties": {
                        "weapon_category": {
                            "type": "string",
                            "enum": [
                                "simple",
                                "martial",
                                "improvised"
                            ]
                        },
                        "weapon_range": {
                            "type": "string",
                            "enum": [
                                "melee",
                                "ranged"
                            ]
                        },
                        "range_normal": {
                            "type": "integer",
                            "description": "Normal range in feet. Required for ranged/thrown weapons."
                        },
                        "range_long": {
                            "type": "integer",
                            "description": "Long range in feet (attacks have disadvantage). Omit if no long range exists."
                        },
                        "damage": {
                            "type": "object",
                            "properties": {
                                "dice": {
                                    "type": "string",
                                    "description": "e.g., '1d8'"
                                },
                                "type": {
                                    "type": "string",
                                    "description": "e.g., 'slashing'"
                                }
                            }
                        },
                        "properties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Array of property IDs like 'prop_finesse'."
                        }
                    }
                },
                "ammunition_data": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "enum": [
                                "arrow",
                                "needle",
                                "bolt",
                                "bullet"
                            ]
                        }
                    }
                },
                "armor_data": {
                    "type": "object",
                    "description": "If present, the game engine treats this item as equippable for AC calculation.",
                    "properties": {
                        "armor_category": {
                            "type": "string",
                            "enum": [
                                "light",
                                "medium",
                                "heavy",
                                "shield"
                            ]
                        },
                        "base_ac": {
                            "type": "integer"
                        },
                        "dex_bonus": {
                            "type": "string",
                            "enum": [
                                "full",
                                "max_2",
                                "none"
                            ]
                        },
                        "str_requirement": {
                            "type": "integer",
                            "default": 0
                        },
                        "stealth_disadvantage": {
                            "type": "boolean",
                            "default": false
                        }
                    }
                },
                "container_data": {
                    "type": "object",
                    "description": "If present, engine treats this as a functional storage container.",
                    "properties": {
                        "weight_limit_lbs": {
                            "type": "number",
                            "description": "Maximum weight it can hold."
                        },
                        "volume_limit_cubic_ft": {
                            "type": "number",
                            "description": "Maximum physical space."
                        },
                        "liquid_limit_ounces": {
                            "type": "number",
                            "description": "For flasks, vials, and barrels."
                        }
                    }
                },
                "mechanics": {
                    "type": "object",
                    "description": "Pointers to active combat abilities granted by holding/using this item.",
                    "properties": {
                        "granted_actions": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "yields_on_consume": {
                    "type": "string",
                    "description": "Item ID of byproduct left behind after use. Omit if the item is completely destroyed (like a torch)."
                },
                "lore": {
                    "type": "object",
                    "properties": {
                        "short_description": {
                            "type": "string",
                            "description": "A quick 1-2 sentence summary for tooltips."
                        },
                        "full_text": {
                            "type": "string",
                            "description": "The main body of text for the entity."
                        },
                        "sections": {
                            "type": "array",
                            "description": "Flexible key-value pairs for categorized flavor text (Age, Alignment, Lore, etc.).",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "title": {
                                        "type": "string"
                                    },
                                    "body": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "title",
                                    "body"
                                ]
                            }
                        }
                    },
                    "required": [
                        "short_description"
                    ]
                }
            },
            "required": [
                "name",
                "category",
                "weight",
                "cost"
            ]
        }
    }
}