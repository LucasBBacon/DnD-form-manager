    "json.schemas": [
        {
            "fileMatch": [
                "spells/*_data.json",
                "spells/*_spell.json"
            ],
            "url": "./form_manager/src/resources/schemas/spell_data_schema.json"
        },
        {
            "fileMatch": [
                "races/*_race.json"
            ],
            "url": "./form_manager/src/resources/schemas/race_data_schema.json"
        },
        {
            "fileMatch": [
                "traits/*_trait.json"
            ],
            "url": "./form_manager/src/resources/schemas/trait_data_schema.json"
        },
        {
            "fileMatch": [
                "classes/*_class.json"
            ],
            "url": "./form_manager/src/resources/schemas/class_data_schema.json"
        },
        {
            "fileMatch": [
                "subclasses/*_subclass.json"
            ],
            "url": "./form_manager/src/resources/schemas/subclass_data_schema.json"
        },
        {
            "fileMatch": [
                "subraces/*_subrace.json"
            ],
            "url": "./form_manager/src/resources/schemas/subrace_data_schema.json"
        },
        {
            "fileMatch": [
                "items/*_item.json",
                "gear/*_item.json",
                "armor/*_item.json",
                "weapon/*_item.json"
            ],
            "url": "./form_manager/src/resources/schemas/item_data_schema.json"
        }
    ]
