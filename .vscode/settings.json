{
    "python.testing.pytestArgs": [
        "form_manager"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "cSpell.words": [
        "countercharm",
        "darkvision",
        "debuff",
        "dwarven",
        "dwarvish",
        "greataxe",
        "Greatsword",
        "handaxe",
        "Longsword",
        "longswords",
        "multiclass",
        "regen",
        "shortsword",
        "shortswords",
        "Spellbook",
        "spellcasting",
        "stackable",
        "stormborn",
        "thiefs",
        "unattune",
        "unattunes",
        "Unattuning",
        "unequip",
        "unequips",
        "warhammer",
        "Waterskin"
    ],
    "json.schemas": [


        {
            "fileMatch": [
                "spells/*_data.json",
                "spells/*_spell.json"
            ],
            "url": "./form_manager/src/resources/schemas/spell_data_schema.json"
        },
        {
            "fileMatch": [
                "races/*_race.json"
            ],
            "url": "./form_manager/src/resources/schemas/race_data_schema.json"
        },
        {
            "fileMatch": [
                "traits/*_trait.json"
            ],
            "url": "./form_manager/src/resources/schemas/trait_data_schema.json"
        },
        {
            "fileMatch": [
                "classes/*_class.json"
            ],
            "url": "./form_manager/src/resources/schemas/class_data_schema.json"
        },
        {
            "fileMatch": [
                "subclasses/*_subclass.json"
            ],
            "url": "./form_manager/src/resources/schemas/subclass_data_schema.json"
        }
    ]
}